{"id":"53eb6d05-1686-4a9a-b25d-c63de2f60e9a","updated_at":"2026-06-09T22:39:01.934Z","updated_by":"3185519865","created_at":"2026-05-29T21:54:31.233Z","created_by":"3185519865","name":"Egress to Sanctioned Country","tags":["network","geo-anomaly","awareness"],"interval":"12h","enabled":true,"revision":9,"description":"Fires on outbound connections to countries on a configurable high-risk list (default: KP, IR, SY, CU, RU, BY). Low-severity awareness alert.","risk_score":25,"severity":"low","note":"- Confirm destination IP geolocation (geo lookups can be stale)\n\n- Check destination organization name — known SaaS in those regions\n\n- Cross-reference with threat intel rules — if source.ip also hit ThreatFox/URLhaus, severity escalates significantly\n\n- Treat in isolation as informational; treat in combination with C2/URLhaus rules as P2\n","license":"","output_index":"","meta":{"kibana_siem_app_url":"https://prime-one.kb.us-west-2.aws.found.io/s/sm_soc_analysts/app/security"},"investigation_fields":{"field_names":["pulse_meta.location_name","pulse_meta.orgs.name","source.ip","destination.ip","destination.as.organization.name","destination.geo.country_name","destination.port"]},"author":[],"false_positives":[],"from":"now-725m","rule_id":"671f209b-fd3a-4c6e-9c2b-8466d4267d93","max_signals":500,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0011","name":"Command and Control","reference":"https://attack.mitre.org/tactics/TA0011/"},"technique":[{"id":"T1071","name":"Application Layer Protocol","reference":"https://attack.mitre.org/techniques/T1071/","subtechnique":[]}]}],"to":"now","references":[],"version":1,"exceptions_list":[{"id":"f8912fd5-307a-4a01-859a-2938e7fece89","list_id":"ec5c0321-8ae2-47b2-a737-fc207a1f3bf4","type":"rule_default","namespace_type":"single"},{"id":"90d851ef-9852-4ec0-8937-a46446c262f8","list_id":"7edf230c-6eaa-4958-9101-662cf59f9764","type":"detection","namespace_type":"single"},{"id":"62